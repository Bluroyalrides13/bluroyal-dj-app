# Luxury Ride Share Agent - Environment Configuration
# Copy this file to .env and fill in your actual values

# API Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Dashboard Access Control
DASHBOARD_USERNAME=djadmin
DASHBOARD_PASSWORD=change-this-now

# Academy App Access Control (separate from DJ dashboard)
ACADEMY_APP_USERNAME=academyadmin
ACADEMY_APP_PASSWORD=change-this-now

# Academy App URL
POST_PURCHASE_LOGIN_URL=https://app.bluroyaladventures.com/academy/login

# Lead Notification Email (for new MultiTasking360 applications)
SUPPORT_EMAIL=multitask360official@gmail.com

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_FROM_EMAIL=notifications@yourdomain.com
SMTP_TO_EMAIL=multitask360official@gmail.com
SMTP_USE_TLS=true

# Claude AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# LangChain Configuration
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_ENABLED=true

# Square Payment Configuration
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_ENVIRONMENT=sandbox
# SQUARE_ENVIRONMENT=production  # Use for production

# Wix Integration Configuration
WIX_API_KEY=your_wix_api_key_here
WIX_SITE_ID=your_wix_site_id_here
WIX_WEBHOOK_SECRET=your_wix_webhook_secret_here

# Database Configuration
# SQLite (local development)
DATABASE_URL=sqlite:///./luxury_rideshare.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost/luxury_rideshare

# CORS Configuration (comma-separated URLs)
# Add your frontend URLs here for production
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000,https://bluroyaladventures.com,https://www.bluroyaladventures.com,https://app.bluroyaladventures.com,https://multitaskingthreesixtyofficial.com,https://www.multitaskingthreesixtyofficial.com
