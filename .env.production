# Production Environment Variables for Docker
# Copy to .env.production and update with real values

# API Configuration
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# Dashboard Access Control
DASHBOARD_USERNAME=djadmin
DASHBOARD_PASSWORD=change-this-now

# Academy App Access Control (separate from DJ dashboard)
ACADEMY_APP_USERNAME=academyadmin
ACADEMY_APP_PASSWORD=change-this-now

# Academy App URL
POST_PURCHASE_LOGIN_URL=https://app.bluroyaladventures.com/academy/login

# Claude AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# LangChain Configuration
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_ENABLED=true

# Square Payment Configuration
SQUARE_ACCESS_TOKEN=your_square_production_token_here
SQUARE_ENVIRONMENT=production
SQUARE_API_VERSION=2024-03-20

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Wix Integration Configuration
WIX_API_KEY=your_wix_api_key_here
WIX_SITE_ID=your_wix_site_id_here
WIX_WEBHOOK_SECRET=your_wix_webhook_secret_here

# Database Configuration - PostgreSQL (Production)
DATABASE_URL=postgresql://rideshare:secure_password@db:5432/luxury_rideshare

# Database Configuration
DB_USER=rideshare
DB_PASSWORD=secure_password
DB_NAME=luxury_rideshare

# PgAdmin (optional)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin_password

# CORS Configuration
CORS_ORIGINS=https://bluroyaladventures.com,https://www.bluroyaladventures.com,https://app.bluroyaladventures.com,https://multitaskingthreesixty.com,https://www.multitaskingthreesixty.com

# Security
SECURE_COOKIES=true
HTTPS_ONLY=true
